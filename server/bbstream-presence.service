[Unit]
Description=Discord Broadcast Box stream presence (UDP 8200)
After=network.target

[Service]
ExecStart=/usr/bin/python3 -u /opt/bbstream/presence.py
Restart=always
DynamicUser=yes
MemoryMax=48M
StateDirectory=bbstream
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
